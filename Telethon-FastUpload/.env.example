TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_TARGET=

# 可选：session 文件路径（默认 ./session.session）
TELEGRAM_SESSION=./session.session

# 可选：session 失效时用于重新登录
TELEGRAM_PHONE=

# 可选：downloads 目录（默认 ./downloads；xiazai/main.py 单文件上传时会随子进程覆盖）
TELEGRAM_DOWNLOAD_DIR=./downloads

# 可选：由 xiazai/main.py 子进程设置；独立运行本脚本时也可在此写死
# TELEGRAM_CAPTION=🎬 某番第1集
# TELEGRAM_THUMB=C:\path\to\cover.jpg

# 默认用内置上传（频道里显示为可点播视频）。装 FastTelethonhelper 并设为 1 才用多连接分片上传
# TELEGRAM_PARALLEL_UPLOAD=0

# 可选：代理（两种方式二选一）
# TELEGRAM_PROXY=socks5://127.0.0.1:7890
# PROXY_ENABLED=true
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890

